# ---------------------------------------------------------------------------
# Kora — variables d'environnement
# Copier ce fichier en `.env` (racine ou backend/) : il est chargé automatiquement
# au démarrage par config/settings.py. Les variables déjà définies dans le shell
# ont priorité (pratique en CI/Docker).
# ---------------------------------------------------------------------------

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=changez-moi-en-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : SQLite si POSTGRES_DB est vide
# POSTGRES_DB=kora
# POSTGRES_USER=kora
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Chiffrement des secrets de management (obligatoire en production)
# Windows PowerShell : .\dev.ps1 ; génération de clé :
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=
SECRET_KEY_VERSION=1

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Workers
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=1

# Connecteur MikroTik
MIKROTIK_FAKE_MODE=1
MIKROTIK_TIMEOUT_SECONDS=10
MIKROTIK_WIREGUARD_ENDPOINT=vpn.kora.bf
MIKROTIK_WIREGUARD_PUBLIC_KEY=
MIKROTIK_MANAGEMENT_NETWORK=10.66.0.0/24
# Vérification du certificat : 0 pour un routeur auto-signé (VM, labo)
MIKROTIK_VERIFY_TLS=0
